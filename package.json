{
  "name": "oracle-app-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant white-label Oracle Card application platform",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "render:build": "npm install && npm run build --workspace=client && npm run seed --workspace=server",
    "render:start": "NODE_ENV=production npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
